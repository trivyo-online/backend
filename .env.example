# MongoDB connection string (required)
MON=mongodb://localhost:27017

# Signs admin login tokens. Set a long random value in production;
# if unset, a random key is used and logins reset on restart.
ADMIN_SECRET=change-me-to-a-long-random-string

# Optional: require this code to create admin accounts
ADMIN_SIGNUP_CODE=

# Optional Redis cache for live events
REDIS_ADDR=
REDIS_USERNAME=
REDIS_PASSWORD=

# Optional: comma-separated allowed origins (unset = any origin)
CORS_ORIGINS=
PORT=8080
